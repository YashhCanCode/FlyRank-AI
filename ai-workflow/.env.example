# Copy to .env.local and fill in. Leave AI_MOCK=1 to run WITHOUT any key.
#
# Mock mode: no API key needed — decisions are deterministic (labelled [MOCK]).
AI_MOCK=1
#
# Real mode: set AI_MOCK=0 and provide an OpenAI-compatible provider.
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=openrouter/free
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.2:3b   (key can be "ollama")
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_key_here
LLM_MODEL=gpt-4o-mini

# Inngest (dev server needs no keys locally)
INNGEST_DEV=1
