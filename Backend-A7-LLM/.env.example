# Copy to .env and fill in. .env is gitignored — never commit a real key.
#   cp .env.example .env
#
# --- Provider (OpenRouter, free tier) ---
# 1) Sign up at openrouter.ai, create a key.
# 2) Settings -> Privacy: turn ON both free-endpoint switches or free models 404.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_key_here
LLM_MODEL=openrouter/free
#
# To run locally on Ollama instead, use:
#   LLM_BASE_URL=http://localhost:11434/v1/
#   LLM_API_KEY=ollama
#   LLM_MODEL=gemma3:1b
#
# --- Endpoint controls ---
PORT=3000
LLM_STUB=0          # 1 = skip the model, return a schema-valid stub (no spend)
LLM_ENABLED=true    # false = kill switch: skip the model, return a clean 503
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
PROMPT_VERSION=triage-v1
