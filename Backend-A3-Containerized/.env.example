# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# `.env` is gitignored so real credentials never get committed.

# --- Postgres credentials (used by the db service in docker-compose) ---
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=taskpass
POSTGRES_DB=tasks

# --- App configuration ---
# Connection string used when you run the app ON YOUR HOST machine
# (e.g. `npm start`) against the Postgres container published on localhost.
# Inside docker-compose the app talks to the db over the compose network and
# this value is overridden to use host `db` instead of `localhost`.
DATABASE_URL=postgres://taskuser:taskpass@localhost:5432/tasks

# Which repository to use: `postgres` (default) or `memory`.
REPO=postgres

# Port the API listens on.
PORT=3000
